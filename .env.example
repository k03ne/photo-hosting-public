# ─── Instanz ────────────────────────────────────────────────────────────────
# Mehrere Instanzen können auf demselben Server in getrennten Ordnern laufen
# (ein Ordner pro Domain, z. B. /srv/foto.beispiel.de). Der Code ist dabei
# identisch — NUR diese .env unterscheidet sie. Jede Instanz braucht daher
# eigene Werte für: PM2_APP_NAME, PORT, DB_PORT, DATABASE_URL, AUTH_SECRET,
# NEXT_PUBLIC_APP_URL und ADMIN_*. Datenbank, Uploads und pm2-Prozess sind
# damit vollständig getrennt; geteilt wird nur der Server.
#
# Name des pm2-Prozesses. Leer = "photo-hosting".
PM2_APP_NAME="photo-hosting"
# Port, auf dem die App lauscht (der Reverse-Proxy der Domain zeigt hierher).
# Leer = 9000. Zweite Instanz z. B. 9001.
PORT="9000"
# Compose-Projektname → trennt DB-Container UND Volume der Instanzen.
# NORMALERWEISE LEER LASSEN: Docker leitet den Namen aus dem Ordnernamen ab,
# und die Ordner unterscheiden sich ohnehin — die Trennung ist also schon da.
#
# ACHTUNG bei einer BESTEHENDEN Instanz: Wird hier nachträglich ein Name
# gesetzt, der nicht dem bisher abgeleiteten entspricht, legt Docker ein NEUES,
# LEERES Volume an — die Datenbank wirkt dann schlagartig frisch (die alten
# Daten liegen noch im alten Volume, die App sieht sie nur nicht mehr).
# Den aktuellen Namen zeigt `docker compose ls` bzw. `docker volume ls`.
# COMPOSE_PROJECT_NAME=""

# Nur nötig, wenn der Deploy „npm nicht gefunden" meldet: bin-Verzeichnis von
# Node. Der Deploy läuft über eine nicht-interaktive SSH-Session und sieht
# deshalb kein per nvm/fnm in ~/.bashrc gesetztes PATH. nvm, fnm, volta und
# /usr/local/bin findet das Deploy-Skript selbst — das hier ist der Notausgang
# für ungewöhnliche Installationsorte.
# NODE_BIN_DIR=""

# ─── Datenbank ──────────────────────────────────────────────────────────────
# Jede Instanz hat einen EIGENEN Postgres-Container mit eigenem Volume (siehe
# COMPOSE_PROJECT_NAME) — geteilt wird nichts. Was sich zwingend unterscheiden
# muss, ist der Host-Port: zwei Container können nicht denselben belegen.
#
# Host-Port des DB-Containers (nicht Standard 5432, nur an localhost gebunden).
# Muss zum Port in DATABASE_URL passen — und je Instanz verschieden sein
# (z. B. 55432 und 55433).
DB_PORT="55432"
# Lokal (docker-compose) oder gehosteter Postgres. Benutzer/Passwort/Datenbank
# dürfen bei beiden Instanzen gleich heißen — sie liegen in getrennten
# Containern. Der PORT muss zu DB_PORT der jeweiligen Instanz passen.
# Hinweis: Der App-Container verbindet sich intern über `db:5432`.
DATABASE_URL="postgresql://photo:photo@localhost:55432/photohosting?schema=public"

# ─── Auth / Session ─────────────────────────────────────────────────────────
# Mit `openssl rand -base64 32` erzeugen
AUTH_SECRET="change-me-please"

# Öffentliche Basis-URL der Anmeldung — HINTER EINEM REVERSE PROXY PFLICHT.
# Ohne diesen Wert baut Next die absolute Request-URL in der Middleware aus
# einem Fallback und leitet auf `http://localhost:<PORT>/admin/login` um: die
# Anmeldung ist dann von außen unerreichbar. Weder ein korrekter `Host`- noch
# ein `X-Forwarded-Host`-Header hilft dagegen, `trustHost: true` allein auch
# nicht — die Variable hat Vorrang und ist die einzige verlässliche Angabe.
# Mit Schema, ohne Pfad und ohne Slash am Ende. Wird zur Laufzeit gelesen,
# ein Neustart genügt (kein Rebuild).
AUTH_URL="http://localhost:3000"

# Erster Admin-Account (wird vom Seed-Script angelegt)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-too"

# ─── Storage ────────────────────────────────────────────────────────────────
# "local" = Filesystem-Volume | "s3" = S3-kompatibel (MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# Maximaler Bildspeicher in GB (Kontingent). Leer/0 = kein Limit. Betreiberseitig
# gesetzt, im Backend nur als Fortschrittsbalken sichtbar (nicht editierbar).
# Ist das Limit erreicht, werden weitere Uploads abgewiesen.
#
# Nur ein SOFTWARE-Limit: gezählt werden die belegten Bytes, ob die Platte so
# viel Platz hat, wird nicht geprüft. Vorher `df -h` ansehen. Mehrere Instanzen
# auf einem Server haben je ein eigenes Limit, teilen sich aber die Platte —
# die Summe darf den freien Platz nicht übersteigen. Wird zur Laufzeit gelesen,
# ein Neustart genügt (kein Rebuild).
STORAGE_LIMIT_GB=""

# Nur bei STORAGE_DRIVER=s3
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="photos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# ─── App ────────────────────────────────────────────────────────────────────
# Absolute Basis-URL für Freigabelinks, Sitemap und Link-Vorschaubilder.
# In Produktion mit `https://` — ein `http://` hier landet wörtlich in
# verschickten Gästelinks und in der Sitemap. ACHTUNG: `NEXT_PUBLIC_*` wird
# zur BUILDZEIT eingebacken; eine Änderung wirkt erst nach einem neuen Build,
# ein Neustart genügt nicht.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Demo-Bilder (optional) ─────────────────────────────────────────────────
# Access Key einer kostenlosen App unter https://unsplash.com/developers
# (Demo-Tier: 50 Anfragen/Stunde). Nur nötig, um leere Alben und die Startseite
# mit Platzhaltern zu füllen — ohne Schlüssel blendet das Backend die Funktion
# einfach aus. Die Bilder werden als Demo markiert und lassen sich gesammelt
# wieder entfernen.
# UNSPLASH_ACCESS_KEY=""

# ─── E-Mail / SMTP (Kontaktformular) ─────────────────────────────────────────
# Primär im Backend konfigurierbar: Seiten → „E-Mail-Versand (SMTP)".
# Die folgenden Variablen sind nur ein OPTIONALER Fallback, falls in der DB
# nichts hinterlegt ist. Sind DB-Werte gesetzt, haben sie Vorrang.
# SMTP_HOST="smtp.deine-domain.de"
# SMTP_PORT="587"
# SMTP_SECURE="false"            # true = implizites TLS (Port 465)
# SMTP_USER="mail@deine-domain.de"
# SMTP_PASS="app-passwort"
# MAIL_FROM="mail@deine-domain.de"
# MAIL_FROM_NAME="Dein Studio"
